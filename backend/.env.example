# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# PostgreSQL Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/verifas_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=verifas_db
DB_USER=postgres
DB_PASSWORD=your_password

# Flask App
FLASK_APP=app.py
FLASK_PORT=5000